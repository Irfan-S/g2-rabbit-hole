# Copy to .env and fill in. Never commit .env.

# Claude (required unless MOCK=1)
ANTHROPIC_API_KEY=
# Faster model = shorter wait on the glasses. Swap for a larger model if you want richer breakdowns.
CLAUDE_MODEL=claude-haiku-5-5
BREAKDOWN_WORDS=600

# Speech-to-text for the spoken topic: "elevenlabs", "deepgram" or "openai"
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# STT_MODEL=            # optional override of the provider's model name

# Shared secret the glasses app must send as X-App-Token. Required once the server is
# deployed (it refuses to start in production without one). Make one with:
#   openssl rand -hex 32
# and put the same value in VITE_API_TOKEN in app/.env.local.
APP_TOKEN=

# Free daily allowance for people with no access code and no keys of their own. Off unless
# FREE_DAILY_BUDGET_USD is set. Each free request is counted at its worst-case price ($0.006
# a topic or question, $0.002 a recording), so this is a ceiling; real spend is about half.
# FREE_DAILY_BUDGET_USD=1      # most the free allowance may cost in a day, for everyone together
# FREE_PER_ADDRESS=30          # free requests a day from one address (a spoken topic is two)
# Separate keys for free use, so limits can be set on them where the keys are issued without
# touching your own. Left empty, free use runs on the main keys above.
# FREE_ANTHROPIC_API_KEY=
# FREE_ELEVENLABS_API_KEY=

# Only for `docker compose` on a rented server. Either a hostname that points at it:
# DOMAIN=rabbit.example.com
# or its bare IP address, which needs the short-lived certificate profile:
# DOMAIN=203.0.113.7
# ACME_PROFILE=shortlived

# Wikimedia asks API clients to identify themselves: put a contact email here.
WIKI_USER_AGENT=g2-rabbit-hole/0.1 (you@example.com)
WIKI_LANG=en

PORT=8787
# MOCK=1                # canned content, no keys or network needed

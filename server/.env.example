# Copy to .env and fill in. Never commit .env.

# Claude (required unless MOCK=1)
ANTHROPIC_API_KEY=
# Faster model = shorter wait on the glasses. Swap for a larger model if you want richer breakdowns.
CLAUDE_MODEL=claude-haiku-5-5
BREAKDOWN_WORDS=600

# Speech-to-text for the spoken topic: "elevenlabs", "deepgram" or "openai"
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# STT_MODEL=            # optional override of the provider's model name

# Shared secret the glasses app must send as X-App-Token. Required once the server is
# deployed (it refuses to start in production without one). Make one with:
#   openssl rand -hex 32
# and put the same value in VITE_API_TOKEN in app/.env.local.
APP_TOKEN=

# Only for `docker compose` on a rented server: the hostname that points at it.
# DOMAIN=rabbit.example.com

# Wikimedia asks API clients to identify themselves: put a contact email here.
WIKI_USER_AGENT=g2-rabbit-hole/0.1 (you@example.com)
WIKI_LANG=en

PORT=8787
# MOCK=1                # canned content, no keys or network needed

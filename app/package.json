{
  "name": "g2-rabbit-hole-app",
  "private": true,
  "version": "0.1.7",
  "author": "Irfan",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "VITE_API_TOKEN= npm run build && if grep -rqE '[0-9a-f]{64}' dist; then echo 'Refusing to pack: the build contains an access code'; exit 1; fi && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
